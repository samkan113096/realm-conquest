{
  "name": "shadow-strike",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8082 --clear",
    "assets:generate": "python3 scripts/generate-assets.py",
    "build:android": "eas build --platform android --profile production",
